# Server-side only. Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Required. The single passphrase that unlocks the app; the API refuses every
# request until it is set. Use a long random string, e.g. `openssl rand -base64 32`.
AUTH_PASSPHRASE=

# Optional but recommended: a separate signing secret for session cookies.
# If unset, one is derived from AUTH_PASSPHRASE. `openssl rand -hex 32`.
AUTH_SESSION_SECRET=

# Optional: comma-separated origins allowed to call the API.
# Defaults to same-origin only, which is what the bundled frontend uses.
ALLOWED_ORIGINS=

# Set to production when deployed. Enables HSTS, the HTTPS redirect and the
# Secure cookie flag, and refuses to start without AUTH_PASSPHRASE.
NODE_ENV=production
PORT=8787

# Optional model overrides. Quality models (e.g. gemini-3.8-flash) get a 12s
# deadline before the chain moves on; lite models get 25s, whether pinned here
# or reached as a fallback.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.5-flash,gemini-3.1-flash-lite
