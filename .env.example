# Server-side only. Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional overrides
GEMINI_MODEL=gemini-3.8-flash
# Tried in order when the model above is unavailable or overloaded
# Quality models (e.g. gemini-3.8-flash) get a 12s deadline before the chain
# moves on; lite models get 25s, whether pinned here or reached as a fallback.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.5-flash,gemini-3.1-flash-lite
PORT=8787
